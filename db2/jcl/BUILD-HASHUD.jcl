//HASHUD   JOB (ACCT),'HASHUD',CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1)
//*==================================================================*
//* Build load module HASHUD from IBMUSER.HDFC.ICSF(HASHUD)           *
//*   LKED1 -> IBMUSER.HDFC.LOAD        (project library)             *
//*   LKED2 -> DSN910.DB9G.RUNLIB.LOAD  (Db2 WLM STEPLIB library)     *
//*==================================================================*
//CLEAN    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE IBMUSER.HDFC.LOAD PURGE
  DELETE IBMUSER.HDFC.COBLIST PURGE
  DELETE IBMUSER.HDFC.LKEDLIST PURGE
  DELETE IBMUSER.HDFC.LKED2 PURGE
  DELETE IBMUSER.HDFC.DONE PURGE
  SET MAXCC=0
/*
//*
//COBOL    EXEC PGM=IGYCRCTL,REGION=0M,
//         PARM='RENT,APOST,LIST,MAP'
//STEPLIB  DD DSN=IGY420.SIGYCOMP,DISP=SHR
//SYSPRINT DD DSN=IBMUSER.HDFC.COBLIST,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(5,5)),DCB=(RECFM=FBA,LRECL=133,BLKSIZE=13300)
//SYSIN    DD DSN=IBMUSER.HDFC.ICSF(HASHUD),DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(MOD,PASS),UNIT=SYSDA,
//         SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT5   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT6   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT7   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//LKED1    EXEC PGM=IEWL,REGION=0M,PARM='LIST,XREF,LET,MAP,RENT'
//SYSPRINT DD DSN=IBMUSER.HDFC.LKEDLIST,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(5,5)),DCB=(RECFM=FBA,LRECL=121,BLKSIZE=12100)
//SYSLIB   DD DSN=CEE.SCEELKED,DISP=SHR
//         DD DSN=CSF.SCSFMOD0,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,PASS)
//SYSLMOD  DD DSN=IBMUSER.HDFC.LOAD(HASHUD),DISP=(NEW,CATLG,KEEP),
//         DSNTYPE=LIBRARY,SPACE=(TRK,(5,5,10)),
//         DCB=(RECFM=U,BLKSIZE=32760)
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//LKED2    EXEC PGM=IEWL,REGION=0M,COND=(4,LT,LKED1),
//         PARM='LIST,XREF,LET,MAP,RENT'
//SYSPRINT DD DSN=IBMUSER.HDFC.LKED2,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(5,5)),DCB=(RECFM=FBA,LRECL=121,BLKSIZE=12100)
//SYSLIB   DD DSN=CEE.SCEELKED,DISP=SHR
//         DD DSN=CSF.SCSFMOD0,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=DSN910.DB9G.RUNLIB.LOAD(HASHUD),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//DONE     EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
HASHUD BUILD COMPLETE
/*
//SYSUT2   DD DSN=IBMUSER.HDFC.DONE,DISP=(NEW,CATLG,DELETE),
//         SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//SYSIN    DD DUMMY
