//HASHDRV  JOB (ACCT),'HASHDRV',CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1)
//*==================================================================*
//* Compile the HASHDRV test driver, link it together with the       *
//* existing HASHUD load module, and run it to see what the stored   *
//* procedure actually returns.                                      *
//*==================================================================*
//CLEAN    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE IBMUSER.HDFC.DRVLOAD PURGE
  DELETE IBMUSER.HDFC.DRVCOB PURGE
  DELETE IBMUSER.HDFC.DRVLKED PURGE
  DELETE IBMUSER.HDFC.DRVRUN PURGE
  DELETE IBMUSER.HDFC.DONE PURGE
  SET MAXCC=0
/*
//*
//COBOL    EXEC PGM=IGYCRCTL,REGION=0M,PARM='RENT,APOST,LIST,MAP'
//STEPLIB  DD DSN=IGY420.SIGYCOMP,DISP=SHR
//SYSPRINT DD DSN=IBMUSER.HDFC.DRVCOB,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(5,5)),DCB=(RECFM=FBA,LRECL=133,BLKSIZE=13300)
//SYSIN    DD DSN=IBMUSER.HDFC.ICSF(HASHDRV),DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(MOD,PASS),UNIT=SYSDA,
//         SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT5   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT6   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT7   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//LKED     EXEC PGM=IEWL,REGION=0M,PARM='LIST,XREF,LET,MAP,RENT'
//SYSPRINT DD DSN=IBMUSER.HDFC.DRVLKED,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(5,5)),DCB=(RECFM=FBA,LRECL=121,BLKSIZE=12100)
//SYSLIB   DD DSN=CEE.SCEELKED,DISP=SHR
//         DD DSN=CSF.SCSFMOD0,DISP=SHR
//         DD DSN=IBMUSER.HDFC.LOAD,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=IBMUSER.HDFC.DRVLOAD(HASHDRV),DISP=(NEW,CATLG,KEEP),
//         DSNTYPE=LIBRARY,SPACE=(TRK,(5,5,10)),
//         DCB=(RECFM=U,BLKSIZE=32760)
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//GO       EXEC PGM=HASHDRV,COND=(4,LT,LKED)
//STEPLIB  DD DSN=IBMUSER.HDFC.DRVLOAD,DISP=SHR
//         DD DSN=CSF.SCSFMOD0,DISP=SHR
//         DD DSN=CEE.SCEERUN,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD DSN=IBMUSER.HDFC.DRVRUN,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(2,2)),DCB=(RECFM=FBA,LRECL=133,BLKSIZE=13300)
//CEEDUMP  DD SYSOUT=*
//*
//DONE     EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
HASHDRV DONE
/*
//SYSUT2   DD DSN=IBMUSER.HDFC.DONE,DISP=(NEW,CATLG,DELETE),
//         SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//SYSIN    DD DUMMY
