//REFRESH  JOB (ACCT),'REFRESH',CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1)
//CLEAN    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE IBMUSER.SP.CMDLOG PURGE
  DELETE IBMUSER.SP.DONE PURGE
  SET MAXCC=0
/*
//CMD1     EXEC PGM=IKJEFT01,DYNAMNBR=50
//STEPLIB  DD DSN=DSN910.SDSNLOAD,DISP=SHR
//SYSTSPRT DD DSN=IBMUSER.SP.CMDLOG,DISP=(MOD,CATLG,KEEP),
//         SPACE=(TRK,(5,5)),DCB=(RECFM=FBA,LRECL=133,BLKSIZE=13300)
//SYSPRINT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB9G)
  -STOP PROCEDURE(BANKAPP.HASHUD)
  -START PROCEDURE(BANKAPP.HASHUD)
  -DISPLAY PROCEDURE(BANKAPP.HASHUD)
  END
/*
//DONE     EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
REFRESH DONE
/*
//SYSUT2   DD DSN=IBMUSER.SP.DONE,DISP=(NEW,CATLG,DELETE),
//         SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//SYSIN    DD DUMMY
