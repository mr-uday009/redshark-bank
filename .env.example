# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Db2 for z/OS (mainframe). Comment out the DB2_* block to run against the
# local PostgreSQL mirror instead.
#
# Access is over JDBC using the Db2 driver plus the free z/OS licence jar. JDBC
# is used instead of the Node `ibm_db` (CLI/ODBC) driver because the latter
# needs a paid Db2 Connect licence to talk to z/OS and fails with SQL1598N even
# with correct credentials.
#
# The JDBC jars are NOT committed (see .gitignore) - they are IBM's and carry
# their own licence. See db2/jdbc-bridge/README.md for how to obtain them.
# ---------------------------------------------------------------------------
DB2_HOST=192.168.200.150
DB2_PORT=5025
DB2_LOCATION=DALLAS9
DB2_USER=IBMUSER
# The ADCD sample system ships with IBMUSER/SYS1. Change this for anything
# that is not a throwaway lab LPAR.
DB2_PASSWORD=changeme

# Bridge the Node app talks to (defaults are fine unless you moved it)
DB2_BRIDGE_URL=http://127.0.0.1:8099

# Java runtime used by the JDBC bridge. Only needed if `java` is not on PATH.
# JAVA_HOME=/path/to/jdk

# ---------------------------------------------------------------------------
# Local PostgreSQL mirror. Used automatically when DB2_HOST is unset.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/app_db

# ---------------------------------------------------------------------------
# Auth rate limiting (token bucket). Optional - defaults shown, all in seconds.
#
#   *_MAX     = bucket capacity, i.e. the largest allowed burst
#   *_WINDOW  = seconds to refill a full bucket from empty
#
# Login is limited twice: per IP, and per account (which is what actually
# protects a password when attempts come from many addresses).
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_IP_WINDOW=300

RATE_LIMIT_LOGIN_ACCT_MAX=5
RATE_LIMIT_LOGIN_ACCT_WINDOW=300

RATE_LIMIT_REGISTER_IP_MAX=5
RATE_LIMIT_REGISTER_IP_WINDOW=3600

RATE_LIMIT_TRANSFER_MAX=10
RATE_LIMIT_TRANSFER_WINDOW=60
